includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - src
    excludePaths:
        - tests
    inferPrivatePropertyTypeFromConstructor: true
    ignoreErrors:
        # Intentionally unused by the package itself; consumed by applications.
        - message: '#Trait MrRijal\\LaravelSms\\Traits\\HasSms is used zero times#'
